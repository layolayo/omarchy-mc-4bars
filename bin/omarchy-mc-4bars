def validate_plugin_id(raw: str) -> str:
    val = (raw or "").strip()
    if not val or ".." in val or not SAFE_PLUGIN_ID_RE.match(val):
        sys.exit(f"Invalid plugin ID: '{raw}'.")
    return val


def discover_valid_bar_widgets() -> dict[str, dict]:
    """Return a dict mapping valid bar-widget plugin ID -> metadata dict."""
    catalogue: dict[str, dict] = {
        pid: {"id": pid, "name": name, "description": "Built-in Omarchy bar module"}
        for pid, name in BUILTIN_OMARCHY_WIDGETS.items()
    }

    # 1. Scan manifest.json files in system and user plugin directories
    for root_dir in (SYSTEM_PLUGINS_DIR, USER_PLUGINS_DIR):
        if not root_dir.exists():
            continue
        for manifest_path in root_dir.rglob("manifest.json"):
            try:
                data = json.loads(manifest_path.read_text(encoding="utf-8"))
                if not isinstance(data, dict):
                    continue
                pid = str(data.get("id", "")).strip()
                kinds = data.get("kinds", [])
                if pid and isinstance(kinds, list) and "bar-widget" in kinds:
                    catalogue[pid] = {
                        "id": pid,
                        "name": str(data.get("name", "")).strip(),
                        "description": str(data.get("description", "")).strip(),
                    }
            except Exception:
                continue

    # 2. Scan custom QML bar modules in ~/.config/omarchy/bar/modules
    custom_modules_dir = Path.home() / ".config/omarchy/bar/modules"
    if custom_modules_dir.exists():
        for qml_file in custom_modules_dir.glob("*.qml"):
            cid = qml_file.stem
            catalogue[cid] = {
                "id": cid,
                "name": cid,
                "description": "Custom QML bar module",
            }

    # 3. Query running omarchy-shell if available
    try:
        res = subprocess.run(
            ["omarchy-shell", "-q", "shell", "listPlugins"],
            capture_output=True,
            text=True,
            timeout=1.5,
            check=False,
        )
        if res.returncode == 0 and res.stdout.strip():
            items = json.loads(res.stdout)
            if isinstance(items, list):
                for item in items:
                    if not isinstance(item, dict):
                        continue
                    pid = str(item.get("id", "")).strip()
                    kinds = item.get("kinds", [])
                    if pid and isinstance(kinds, list) and "bar-widget" in kinds:
                        existing = catalogue.get(pid, {})
                        catalogue[pid] = {
                            "id": pid,
                            "name": str(item.get("name") or existing.get("name") or "").strip(),
                            "description": existing.get("description", ""),
                        }
    except Exception:
        pass

    return catalogue


def resolve_plugin_id(cfg: dict, raw: str) -> str:
    val = validate_plugin_id(raw)
    low = val.lower()
    catalogue = discover_valid_bar_widgets()

    # 1. Explicit alias table
    if low in PLUGIN_SHORT_ALIASES:
        aliased = PLUGIN_SHORT_ALIASES[low]
        if not catalogue or aliased in catalogue:
            return aliased

    # 2. Exact ID match in valid bar-widget catalogue
    if val in catalogue:
        return val
    for pid in catalogue:
        if pid.lower() == low:
            return pid

    # 3. Unique suffix match (e.g. 'clock' -> 'omarchy.clock', 'moon-phase' -> 'jeffmtb.moon-phase')
    suffix_matches = [
        pid for pid in catalogue if pid.lower().endswith("." + low)
    ]
    if len(suffix_matches) == 1:
        return suffix_matches[0]

    # 4. Exact display name match (e.g. 'moon-phase' -> 'Moon Phase')
    norm_low = re.sub(r"[^a-z0-9]+", "", low)
    name_matches = [
        pid
        for pid, meta in catalogue.items()
        if re.sub(r"[^a-z0-9]+", "", meta.get("name", "").lower()) == norm_low
    ]
    if len(name_matches) == 1:
        return name_matches[0]

    # 5. Unique substring match in plugin ID or display name (e.g. 'xm5' or 'sony' -> 'io.github.delarosa1312.sony-xm5')
    if len(low) >= 3:
        sub_matches = [
            pid
            for pid, meta in catalogue.items()
            if low in pid.lower().split(".")[-1] or low in meta.get("name", "").lower()
        ]
        if len(sub_matches) == 1:
            return sub_matches[0]

    # Not a valid bar-widget plugin — build helpful suggestions and abort
    suggestions = []
    for pid, meta in catalogue.items():
        haystack = f"{pid} {meta.get('name', '')} {meta.get('description', '')}".lower()
        if low in haystack:
            suggestions.append(pid)
    short_names = {pid.split(".")[-1].lower(): pid for pid in catalogue}
    for close in difflib.get_close_matches(low, list(catalogue.keys()) + list(short_names.keys()), n=4, cutoff=0.45):
        resolved = short_names.get(close, close)
        if resolved not in suggestions:
            suggestions.append(resolved)

    msg = f"Error: '{raw}' is not a valid installed Omarchy bar-widget plugin."
    if suggestions:
        msg += f"\nDid you mean: {', '.join(suggestions[:5])}?"
    sys.exit(msg)


def prune_invalid_entries(cfg: dict) -> list[tuple[str, str]]:
    """Remove any entries from all 4 bars that are not in the valid bar-widget catalogue."""
    catalogue = discover_valid_bar_widgets()
    if not catalogue:
        return []
    removed: list[tuple[str, str]] = []
    for slot_key, _def_pos, _label in BAR_SLOTS:
        layout = cfg.get(slot_key, {}).get("layout", {})
        for sec in SECTIONS:
            items = layout.get(sec)
            if not isinstance(items, list):
                continue
            kept = []
            for item in items:
                # Preserve inline custom command/qml modules
                if isinstance(item, dict) and (item.get("exec") or item.get("source") or item.get("type")):
                    kept.append(item)
                    continue
                eid = entry_id(item)
                if eid and eid not in catalogue:
                    removed.append((slot_key, eid))
                else:
                    kept.append(item)
            layout[sec] = kept
    return removed


def resolve_section(raw: str) -> str:
    key = (raw or "").strip().lower()
    if key not in SECTION_ALIASES:
        sys.exit(
            f"Unknown section '{raw}'. Use L/M/R (horizontal), T/M/B (vertical), or tray."
        )
    return SECTION_ALIASES[key]


def entry_id(item) -> str:
    if isinstance(item, str):
        return item.strip()
    if isinstance(item, dict) and isinstance(item.get("id"), str):
        return item["id"].strip()
    return ""


def load_config() -> dict:
    if not SHELL_JSON.exists():
        sys.exit(f"Missing configuration file: {SHELL_JSON}")
    with SHELL_JSON.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        sys.exit(f"Malformed configuration root in {SHELL_JSON}")
    return data


def save_config(cfg: dict) -> None:
    parent = SHELL_JSON.parent
    parent.mkdir(parents=True, exist_ok=True)
    with SHELL_JSON.open("w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")


def ensure_all_bars(cfg: dict) -> None:
    for slot_key, default_pos, _label in BAR_SLOTS:
        bar = cfg.setdefault(slot_key, {})
        pos = str(bar.get("position", default_pos)).strip().lower()
        bar["position"] = pos if pos in EDGES else default_pos
        bar.setdefault("background", "none")
        layout = bar.setdefault("layout", {})
        for sec in ("left", "center", "right"):
            if not isinstance(layout.get(sec), list):
                layout[sec] = []


def resolve_bar_slot(cfg: dict, target_raw: str) -> str:
    """Resolve an edge name ('top', 'bottom', 'left', 'right') or slot key to the matching slot key."""
    ensure_all_bars(cfg)
    key = (target_raw or "").strip().lower()
    if key in SLOT_ALIASES:
        return SLOT_ALIASES[key]
    if key in EDGES:
        for slot_key, default_pos, _label in BAR_SLOTS:
            pos = str(cfg.get(slot_key, {}).get("position", default_pos)).strip().lower()
            if pos == key:
                return slot_key
        # Fallback to default mapping if no slot currently claims that edge
        for slot_key, default_pos, _label in BAR_SLOTS:
            if default_pos == key:
                return slot_key
    sys.exit(
        f"Unknown bar or edge '{target_raw}'. Use top, bottom, left, right, bar, bottomBar, leftBar, or rightBar."
    )


def ensure_plugin_enabled(cfg: dict, plugin_id: str) -> bool:
    plugins = cfg.setdefault("plugins", [])
    cleaned = [p for p in plugins if entry_id(p) not in LEGACY_PLUGIN_IDS]
    changed = len(cleaned) != len(plugins)
    plugins[:] = cleaned
    for entry in plugins:
        if entry_id(entry) == plugin_id:
            if isinstance(entry, dict) and entry.get("enabled") is False:
                entry["enabled"] = True
                return True
            return changed
    plugins.append({"id": plugin_id})
    return True


def pop_from_layout(layout: dict, target_id: str):
    """Remove all occurrences of target_id across sections and return the first full entry."""
    found_entry = None
    for sec in SECTIONS:
        items = layout.get(sec)
        if not isinstance(items, list):
            continue
        kept = []
        for item in items:
            if entry_id(item) == target_id:
                if found_entry is None:
                    found_entry = item
            else:
                kept.append(item)
        layout[sec] = kept
    return found_entry


def insert_into_section(items: list, entry, before: str = None, after: str = None, index: int = None) -> None:
    if index is not None:
        idx = max(0, min(index, len(items)))
        items.insert(idx, entry)
        return
    if before:
        for i, existing in enumerate(items):
            if entry_id(existing) == before:
                items.insert(i, entry)
                return
    if after:
        for i, existing in enumerate(items):
            if entry_id(existing) == after:
                items.insert(i + 1, entry)
                return
    items.append(entry)


def call_ipc(*args: str, quiet: bool = False) -> int:
    cmd = ["omarchy-shell", "-q", PLUGIN_ID, *args] if quiet else ["omarchy-shell", PLUGIN_ID, *args]
    if quiet:
        res = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    else:
        res = subprocess.run(cmd, check=False)
    return res.returncode


def count_widgets(layout: dict) -> int:
    total = 0
    for sec in SECTIONS:
        items = layout.get(sec, [])
        if isinstance(items, list):
            total += sum(1 for x in items if entry_id(x))
    return total


def short_label(pid: str) -> str:
    parts = pid.split(".")
    if len(parts) > 1:
        return f"{parts[-1]} [{pid}]"
    return pid


def print_layout(cfg: dict) -> None:
    ensure_all_bars(cfg)
    for slot_key, default_pos, title in BAR_SLOTS:
        bbar = cfg.get(slot_key, {})
        pos = bbar.get("position", default_pos)
        bg = bbar.get("background", "none")
        layout = bbar.get("layout", {})
        total = count_widgets(layout)
        state = "active" if (total > 0 or slot_key == "bar") else "dormant (0 surfaces)"
        print(f"{title} [{slot_key}] — edge: {pos}, background: {bg}, status: {state}")
        if pos in ("left", "right"):
            labels = [("T (top)", "left"), ("M (middle)", "center"), ("B (bottom)", "right"), ("Tray", "tray")]
        else:
            labels = [("L (left)", "left"), ("M (middle)", "center"), ("R (right)", "right"), ("Tray", "tray")]
        for label, sec in labels:
            items = layout.get(sec, [])
            if not items and sec == "tray":
                continue
            ids = [short_label(entry_id(x)) for x in items if entry_id(x)]
            joined = ", ".join(ids) if ids else "(empty)"
            print(f"  {label:10}: {joined}")
        print()


def run_tui() -> None:
    import curses

    def _tui_main(stdscr):
        curses.curs_set(0)
        curses.use_default_colors()
        if curses.has_colors():
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(3, curses.COLOR_GREEN, -1)
            curses.init_pair(4, curses.COLOR_YELLOW, -1)
            curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_RED)

        def _put(y: int, x: int, text: str, attr: int = 0) -> None:
            my, mx = stdscr.getmaxyx()
            if y < 0 or y >= my or x < 0 or x >= mx - 1:
                return
            clipped = text[: max(0, mx - x - 1)]
            if not clipped:
                return
            try:
                stdscr.addstr(y, x, clipped, attr)
            except curses.error:
                pass

        def _tui_reload(touch_primary: bool) -> None:
            if touch_primary:
                subprocess.run(
                    ["omarchy-shell", "-q", "shell", "reloadConfig"],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
            call_ipc("reloadConfig", quiet=True)
            stdscr.clear()

        bar_idx = 0
        row_idx = 0
        scroll_offset = 0
        follow_eid = None
        show_help = False
        pending_remove = None  # tuple: (slot_key, pos_label, eid)
        status_msg = "Ready — use ↑/↓ to select a widget, ? for full guide, or q to quit."

        while True:
            cfg = load_config()
            ensure_all_bars(cfg)
            slot_key, def_pos, bar_title = BAR_SLOTS[bar_idx]
            bbar = cfg[slot_key]
            pos = bbar.get("position", def_pos)
            bg = bbar.get("background", "none")
            is_vert = pos in ("left", "right")
            sec_names = [
                ("left", "T (top)" if is_vert else "L (left)", "1"),
                ("center", "M (middle)", "2"),
                ("right", "B (bottom)" if is_vert else "R (right)", "3"),
                ("tray", "Tray (drawer)", "4"),
            ]
            sec_label_map = {k: lbl for k, lbl, _hk in sec_names}

            # Build both grouped visual lines (display_lines) and selectable widget entries (flat_rows)
            # display_lines item: (kind, text, selectable_index_or_None)
            display_lines = []
            flat_rows = []
            for sec_key, sec_label, hk in sec_names:
                items = [x for x in bbar["layout"].get(sec_key, []) if entry_id(x)]
                hdr_title = f"── [{hk}] {sec_label} ({len(items)}) "
                display_lines.append(("header", hdr_title, None))
                if not items:
                    display_lines.append(("empty", "      (empty)", None))
                else:
                    for idx, item in enumerate(items):
                        eid = entry_id(item)
                        sel_i = len(flat_rows)
                        display_line_idx = len(display_lines)
                        flat_rows.append((sec_key, sec_label, idx, eid, display_line_idx))
                        short = eid.split(".")[-1]
                        display_lines.append(("item", f"    • {short:24}  ({eid})", sel_i))
                display_lines.append(("spacer", "", None))

            if follow_eid:
                for i, (_sk, _sl, _idx, eid, _dli) in enumerate(flat_rows):
                    if eid == follow_eid:
                        row_idx = i
                        break
                follow_eid = None

            if flat_rows:
                row_idx = max(0, min(row_idx, len(flat_rows) - 1))
            else:
                row_idx = 0

            stdscr.erase()
            max_y, max_x = stdscr.getmaxyx()

            # Top Title Bar with explicit [?] Guide and [q] Quit
            header_left = " MC 4Bars — Interactive Terminal Manager "
            header_right = " [?] Guide/Help   [q] Quit "
            _put(0, 0, header_left, curses.A_BOLD | (curses.color_pair(1) if curses.has_colors() else 0))
            if max_x > len(header_left) + len(header_right) + 2:
                _put(
                    0,
                    max_x - len(header_right) - 1,
                    header_right,
                    curses.A_BOLD | (curses.color_pair(4) if curses.has_colors() else 0),
                )

            if show_help:
                guide_lines = [
                    "┌── MC 4Bars Interactive TUI — Instructions & Keybinding Guide ──────────────────┐",
                    "│                                                                                │",
                    "│  NAVIGATION                                                                    │",
                    "│    ↑ / ↓  or  k / j       Move selection highlight up or down across widgets   │",
                    "│    Tab    or  ← / →       Switch between the 4 Bars (Primary, Bottom, L, R)    │",
                    "│                                                                                │",
                    "│  MOVE SELECTED WIDGET WITHIN CURRENT BAR (SECTIONS)                            │",
                    "│    1                      Move to L (left)   [or T (top) on vertical bars]     │",
                    "│    2                      Move to M (middle)                                   │",
                    "│    3                      Move to R (right)  [or B (bottom) on vertical bars]  │",
                    "│    4                      Move to Tray (drawer)                                │",
                    "│    [  or  ]               Reorder selected widget earlier/later in its section │",
                    "│                                                                                │",
                    "│  SEND SELECTED WIDGET TO ANOTHER SCREEN EDGE BAR                               │",
                    "│    t                      Send widget to TOP bar                               │",
                    "│    b                      Send widget to BOTTOM bar                            │",
                    "│    l                      Send widget to LEFT bar                              │",
                    "│    r                      Send widget to RIGHT bar                             │",
                    "│                                                                                │",
                    "│  REMOVE / BAR APPEARANCE / EXIT                                                │",
                    "│    x  or  d  or  Delete   Remove selected widget (asks [y/n] confirmation)     │",
                    "│    g                      Cycle current bar background (none → glassy → opaque)│",
                    "│    m                      Open graphical point-and-click GUI Manager           │",
                    "│    ?  or  h               Toggle this Instructions & Guide screen              │",
                    "│    q  or  Esc             Quit the TUI                                         │",
                    "└────────────────────────────────────────────────────────────────────────────────┘",
                    "",
                    "                   Press ANY KEY to return to the widget list...                  ",
                ]
                gy = 2
                for gline in guide_lines:
                    if gy >= max_y - 1:
                        break
                    attr = curses.color_pair(1) | curses.A_BOLD if "──" in gline or "Press ANY KEY" in gline else 0
                    _put(gy, 0, gline, attr)
                    gy += 1
                stdscr.refresh()
                stdscr.getch()
                show_help = False
                stdscr.clear()
                continue

            # Draw bar tabs
            tab_x = 0
            for i, (sk, dp, bt) in enumerate(BAR_SLOTS):
                s_pos = cfg[sk].get("position", dp).upper()
                cnt = count_widgets(cfg[sk].get("layout", {}))
                lbl = f" {bt} [{s_pos}:{cnt}] "
                attr = curses.color_pair(2) | curses.A_BOLD if i == bar_idx else curses.A_DIM
                if tab_x + len(lbl) < max_x:
                    _put(2, tab_x, lbl, attr)
                    tab_x += len(lbl) + 1

            info = f"Current Bar: {bar_title} ({slot_key})  |  Edge: {pos.upper()}  |  Background: {bg}"
            _put(4, 0, info, curses.A_BOLD)

            list_start_y = 6
            footer_lines = 4
            avail_rows = max(1, max_y - list_start_y - footer_lines)

            if flat_rows:
                target_dli = flat_rows[row_idx][4]
                # Keep the section header line visible when the first item in a section is selected
                min_visible_dli = max(0, target_dli - 1)
                if min_visible_dli < scroll_offset:
                    scroll_offset = min_visible_dli
                elif target_dli >= scroll_offset + avail_rows:
                    scroll_offset = target_dli - avail_rows + 1
            else:
                scroll_offset = 0
            scroll_offset = max(0, min(scroll_offset, max(0, len(display_lines) - avail_rows)))

            y = list_start_y
            visible_slice = display_lines[scroll_offset:scroll_offset + avail_rows]
            for kind, text, sel_i in visible_slice:
                if y >= max_y - footer_lines:
                    break
                if kind == "header":
                    pad_len = max(0, min(68, max_x - 2) - len(text))
                    line = text + ("─" * pad_len)
                    attr = curses.color_pair(1) | curses.A_BOLD if curses.has_colors() else curses.A_BOLD
                    _put(y, 0, line, attr)
                elif kind == "empty":
                    _put(y, 0, text, curses.A_DIM)
                elif kind == "item":
                    selected = (sel_i == row_idx)
                    prefix = "  ▸ " if selected else "    "
                    line = prefix + text.lstrip(" •")
                    attr = (curses.color_pair(2) | curses.A_BOLD) if selected else 0
                    _put(y, 0, line, attr)
                y += 1

            # Permanent instructions + latest action status (or confirmation prompt) at the bottom
            sec_hint = "1:T(top) 2:M(mid) 3:B(bot) 4:Tray" if is_vert else "1:L(left) 2:M(mid) 3:R(right) 4:Tray"
            help_line_1 = "Navigate : Tab/←/→ switch bar | ↑/↓ (j/k) select widget | [/] reorder | ?:Guide | q:Quit"
            help_line_2 = f"Actions  : {sec_hint} | t/b/l/r send to Top/Bottom/Left/Right | x/d:Remove | g:BG | m:GUI"

            if max_y >= 10:
                if pending_remove is not None:
                    _pr_slot, pr_pos, pr_eid = pending_remove
                    pr_short = pr_eid.split(".")[-1]
                    prompt_str = f" CONFIRM REMOVE: Delete '{pr_short}' ({pr_eid}) from {pr_pos} bar? Press [y] to confirm or [n/Esc] to cancel "
                    _put(
                        max_y - 3,
                        0,
                        prompt_str,
                        curses.color_pair(5) | curses.A_BOLD if curses.has_colors() else curses.A_REVERSE | curses.A_BOLD,
                    )
                else:
                    _put(
                        max_y - 3,
                        0,
                        f"Status   : {status_msg}",
                        curses.color_pair(3) | curses.A_BOLD if curses.has_colors() else curses.A_BOLD,
                    )
                _put(
                    max_y - 2,
                    0,
                    help_line_1,
                    curses.color_pair(4) if curses.has_colors() else curses.A_DIM,
                )
                _put(
                    max_y - 1,
                    0,
                    help_line_2,
                    curses.color_pair(4) if curses.has_colors() else curses.A_DIM,
                )

            stdscr.refresh()
            ch = stdscr.getch()

            # Handle confirmation prompt first if active
            if pending_remove is not None:
                pr_slot, pr_pos, pr_eid = pending_remove
                pr_short = pr_eid.split(".")[-1]
                pending_remove = None
                if ch in (ord("y"), ord("Y")):
                    pop_from_layout(cfg[pr_slot]["layout"], pr_eid)
                    save_config(cfg)
                    _tui_reload(pr_slot == "bar")
                    status_msg = f"Removed '{pr_short}' ({pr_eid}) from {pr_pos} bar ({pr_slot})."
                else:
                    stdscr.clear()
                    status_msg = f"Cancelled removal of '{pr_short}'."
                continue

            if ch in (ord("q"), ord("Q"), 27):
                break
            elif ch in (ord("?"), ord("h"), ord("H")):
                show_help = True
                stdscr.clear()
            elif ch in (ord("\t"), curses.KEY_RIGHT):
                bar_idx = (bar_idx + 1) % len(BAR_SLOTS)
                row_idx = 0
                scroll_offset = 0
                stdscr.clear()
            elif ch == curses.KEY_LEFT:
                bar_idx = (bar_idx - 1) % len(BAR_SLOTS)
                row_idx = 0
                scroll_offset = 0
                stdscr.clear()
            elif ch in (curses.KEY_UP, ord("k")):
                if flat_rows:
                    row_idx = (row_idx - 1) % len(flat_rows)
            elif ch in (curses.KEY_DOWN, ord("j")):
                if flat_rows:
                    row_idx = (row_idx + 1) % len(flat_rows)
            elif ch in (ord("m"), ord("M")):
                subprocess.run(
                    ["omarchy-shell", "-q", "shell", "toggle", PLUGIN_ID, "{}"],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                break
            elif ch in (ord("g"), ord("G")):
                order = ["none", "glassy", "opaque"]
                cur = bbar.get("background", "none")
                nxt = order[(order.index(cur) + 1) % len(order)] if cur in order else "none"
                bbar["background"] = nxt
                save_config(cfg)
                _tui_reload(slot_key == "bar")
                status_msg = f"Set {slot_key} background to '{nxt}'."
            elif flat_rows and ch in (ord("x"), ord("X"), ord("d"), ord("D"), curses.KEY_DC, curses.KEY_BACKSPACE, 127):
                _sk, _sl, _idx, eid, _dli = flat_rows[row_idx]
                pending_remove = (slot_key, pos.upper(), eid)
            elif flat_rows and ch in (ord("["), ord("]")):
                sec_key, sec_label, idx, eid, _dli = flat_rows[row_idx]
                items = bbar["layout"].get(sec_key, [])
                delta = -1 if ch == ord("[") else 1
                new_idx = idx + delta
                if 0 <= new_idx < len(items):
                    items[idx], items[new_idx] = items[new_idx], items[idx]
                    save_config(cfg)
                    _tui_reload(slot_key == "bar")
                    follow_eid = eid
                    status_msg = f"Reordered '{eid.split('.')[-1]}' in {sec_label}."
            elif flat_rows and ch in (ord("1"), ord("2"), ord("3"), ord("4")):
                target_sec = {"1": "left", "2": "center", "3": "right", "4": "tray"}[chr(ch)]
                _sk, _sl, _idx, eid, _dli = flat_rows[row_idx]
                popped = pop_from_layout(bbar["layout"], eid) or {"id": eid}
                bbar["layout"].setdefault(target_sec, []).append(popped)
                save_config(cfg)
                _tui_reload(slot_key == "bar")
                follow_eid = eid
                status_msg = f"Moved '{eid.split('.')[-1]}' to {sec_label_map[target_sec]} on {pos.upper()} bar."
            elif flat_rows and ch in (ord("t"), ord("b"), ord("l"), ord("r")):
                edge_map = {ord("t"): "top", ord("b"): "bottom", ord("l"): "left", ord("r"): "right"}
                target_edge = edge_map[ch]
                dest_slot = resolve_bar_slot(cfg, target_edge)
                sec_key, _sl, _idx, eid, _dli = flat_rows[row_idx]
                popped = pop_from_layout(bbar["layout"], eid) or {"id": eid}
                cfg[dest_slot]["layout"].setdefault(sec_key, []).append(popped)
                save_config(cfg)
                _tui_reload(slot_key == "bar" or dest_slot == "bar")
                status_msg = f"Sent '{eid.split('.')[-1]}' → {target_edge.upper()} bar ({dest_slot})."

    curses.wrapper(_tui_main)


def parse_move_flags(args: list):
    before = None
    after = None
    index = None
    i = 0
    while i < len(args):
        flag = args[i]
        if flag == "--before" and i + 1 < len(args):
            before = validate_plugin_id(args[i + 1])
            i += 2
        elif flag == "--after" and i + 1 < len(args):
            after = validate_plugin_id(args[i + 1])
            i += 2
        elif flag == "--index" and i + 1 < len(args):
            try:
                index = int(args[i + 1])
            except ValueError:
                sys.exit(f"Invalid integer for --index: '{args[i + 1]}'")
            i += 2
        else:
            sys.exit(f"Unrecognised option: {flag}")
    return before, after, index


def cmd_move(plugin_id_raw: str, section_raw: str, extra_args: list, target_bar_or_edge: str = "bottomBar") -> None:
    sec = resolve_section(section_raw)
    before_raw, after_raw, index = parse_move_flags(extra_args)

    cfg = load_config()
    ensure_all_bars(cfg)
    pruned = prune_invalid_entries(cfg)
    before = resolve_plugin_id(cfg, before_raw) if before_raw else None
    after = resolve_plugin_id(cfg, after_raw) if after_raw else None

    raw_items = [p.strip() for p in plugin_id_raw.split(",") if p.strip()]
    if not raw_items:
        sys.exit(f"Invalid plugin ID: '{plugin_id_raw}'.")
    plugin_ids = [resolve_plugin_id(cfg, p) for p in raw_items]

    dest_slot = resolve_bar_slot(cfg, target_bar_or_edge)
    rescan_needed = ensure_plugin_enabled(cfg, PLUGIN_ID)

    touched_primary = dest_slot == "bar"
    dest_bar = cfg[dest_slot]
    dest_bar["layout"].setdefault(sec, [])

    for plugin_id in plugin_ids:
        existing_entry = None
        for slot_key, _def_pos, _label in BAR_SLOTS:
            popped = pop_from_layout(cfg[slot_key]["layout"], plugin_id)
            if popped is not None:
                if slot_key == "bar":
                    touched_primary = True
                if existing_entry is None:
                    existing_entry = popped
        entry = existing_entry if existing_entry is not None else {"id": plugin_id}
        insert_into_section(dest_bar["layout"][sec], entry, before=before, after=after, index=index)
        if after:
            after = plugin_id

    save_config(cfg)
    if rescan_needed:
        subprocess.run(["omarchy-shell", "-q", "shell", "rescanPlugins"], check=False)
    if touched_primary or rescan_needed:
        subprocess.run(["omarchy-shell", "-q", "shell", "reloadConfig"], check=False)
    call_ipc("reloadConfig")

    for slot_k, bad_id in pruned:
        print(f"Cleaned invalid entry '{bad_id}' from {slot_k}.")
    edge = dest_bar.get("position", "bottom")
    if edge in ("left", "right"):
        sec_display = {"left": "T (top)", "center": "M (middle)", "right": "B (bottom)", "tray": "tray"}.get(sec, sec)
    else:
        sec_display = {"left": "L (left)", "center": "M (middle)", "right": "R (right)", "tray": "tray"}.get(sec, sec)
    for plugin_id in plugin_ids:
        print(f"Positioned '{plugin_id}' on {edge} bar ({dest_slot}) in section '{sec_display}'.")


def move_or_swap_edge(cfg: dict, source_slot: str, target_edge: str) -> tuple[str, str]:
    """Move source_slot to target_edge; if another bar occupies target_edge, swap them."""
    ensure_all_bars(cfg)
    source_edge = cfg[source_slot].get("position", "bottom")
    if source_edge == target_edge:
        return source_edge, ""

    occupant_slot = ""
    for slot_key, _def_pos, _label in BAR_SLOTS:
        if slot_key == source_slot:
            continue
        if cfg[slot_key].get("position") == target_edge:
            occupant_slot = slot_key
            break

    cfg[source_slot]["position"] = target_edge
    if occupant_slot:
        cfg[occupant_slot]["position"] = source_edge

    return source_edge, occupant_slot


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0].lower() in ("list", "ls", "status"):
        print_layout(load_config())
        return

    sub = args[0].lower()
    if sub in ("-h", "--help", "help"):
        print(__doc__.strip())
        return

    if sub in ("clean", "prune"):
        cfg = load_config()
        ensure_all_bars(cfg)
        pruned = prune_invalid_entries(cfg)
        if not pruned:
            print("All configured bar widgets across all 4 bars are valid.")
            return
        save_config(cfg)
        if any(slot_k == "bar" for slot_k, _ in pruned):
            subprocess.run(["omarchy-shell", "-q", "shell", "reloadConfig"], check=False)
        call_ipc("reloadConfig")
        for slot_k, bad_id in pruned:
            print(f"Removed invalid plugin entry '{bad_id}' from {slot_k}.")
        return

    if sub in ("tui", "ui", "interactive", "i"):
        run_tui()
        return

    if sub in ("manager", "gui", "panel", "settings"):
        res = subprocess.run(["omarchy-shell", "shell", "toggle", PLUGIN_ID, "{}"], check=False)
        sys.exit(res.returncode)

    if sub in ("toggle", "show", "hide"):
        if len(args) >= 2 and args[1].lower() in EDGES:
            edge = args[1].lower()
            ipc_fn = "toggleEdge" if sub == "toggle" else ("showEdge" if sub == "show" else "hideEdge")
            sys.exit(call_ipc(ipc_fn, edge))
        sys.exit(call_ipc(sub))

    if sub == "swap":
        if len(args) < 3:
            sys.exit("Usage: omarchy mc-4bars swap <top|bottom|left|right> <top|bottom|left|right>")
        cfg = load_config()
        ensure_all_bars(cfg)
        slot_a = resolve_bar_slot(cfg, args[1])
        slot_b = resolve_bar_slot(cfg, args[2])
        edge_a = cfg[slot_a]["position"]
        edge_b = cfg[slot_b]["position"]
        if edge_a == edge_b:
            print(f"Both arguments resolve to the '{edge_a}' edge; nothing to swap.")
            return
        cfg[slot_a]["position"] = edge_b
        cfg[slot_b]["position"] = edge_a
        save_config(cfg)
        if slot_a == "bar" or slot_b == "bar":
            subprocess.run(["omarchy-shell", "-q", "shell", "reloadConfig"], check=False)
        call_ipc("reloadConfig")
        print(f"Swapped {slot_a} ({edge_a} → {edge_b}) and {slot_b} ({edge_b} → {edge_a}).")
        return

    if sub == "open":
        if len(args) < 2:
            sys.exit("Usage: omarchy mc-4bars open <plugin-id>")
        cfg = load_config()
        pid = resolve_plugin_id(cfg, args[1])
        sys.exit(call_ipc("togglePlugin", pid))

    if sub in ("move", "put", "add", "set"):
        if len(args) < 3:
            sys.exit("Usage: omarchy mc-4bars move <plugin-id> [edge-or-bar] <L|M|R|T|B> [--before <id>|--after <id>|--index <n>]")
        # Support both `move <id> <L|M|R|T|B>` and `move <id> <edge|bar> <L|M|R|T|B>`
        if len(args) >= 4 and (args[2].lower() in EDGES or args[2].lower() in SLOT_ALIASES) and args[3].lower() in SECTION_ALIASES:
            cmd_move(args[1], args[3], args[4:], target_bar_or_edge=args[2])
        else:
            cmd_move(args[1], args[2], args[3:], target_bar_or_edge="bottomBar")
        return

    if sub in ("top", "bottom", "left", "right", "unmove", "restore"):
        target_edge = "top" if sub in ("top", "unmove", "restore") else sub
        if len(args) < 2:
            sys.exit(f"Usage: omarchy mc-4bars {sub} <plugin-id> [L|M|R|T|B] [--before <id>|--after <id>|--index <n>]")
        default_sec = "right" if target_edge == "top" else "center"
        sec_raw = args[2] if len(args) >= 3 and not args[2].startswith("--") else default_sec
        extra = args[3:] if len(args) >= 3 and not args[2].startswith("--") else args[2:]
        cmd_move(args[1], sec_raw, extra, target_bar_or_edge=target_edge)
        return

    if sub in ("remove", "rm"):
        auto_yes = "-y" in args[1:] or "--yes" in args[1:]
        pos_args = [a for a in args[1:] if a not in ("-y", "--yes")]
        if not pos_args:
            sys.exit("Usage: omarchy mc-4bars remove <plugin-id> [-y|--yes]")
        raw_pid = validate_plugin_id(pos_args[0])
        cfg = load_config()
        ensure_all_bars(cfg)

        # Find matching entry across all 4 bars (exact ID, short suffix, or resolved ID)
        matches = []
        for slot_key, def_pos, _label in BAR_SLOTS:
            layout = cfg[slot_key]["layout"]
            edge = cfg[slot_key].get("position", def_pos)
            for sec in SECTIONS:
                for item in layout.get(sec, []):
                    eid = entry_id(item)
                    if eid and (eid.lower() == raw_pid.lower() or eid.lower().endswith("." + raw_pid.lower())):
                        matches.append((slot_key, edge, sec, eid))
        if not matches:
            resolved_pid = resolve_plugin_id(cfg, raw_pid)
            for slot_key, def_pos, _label in BAR_SLOTS:
                layout = cfg[slot_key]["layout"]
                edge = cfg[slot_key].get("position", def_pos)
                for sec in SECTIONS:
                    for item in layout.get(sec, []):
                        eid = entry_id(item)
                        if eid == resolved_pid:
                            matches.append((slot_key, edge, sec, eid))

        if not matches:
            sys.exit(f"'{raw_pid}' was not found on any of the 4 bars.")

        slot_key, edge, sec, target_eid = matches[0]
        if not auto_yes and sys.stdin.isatty():
            ans = input(f"Remove '{target_eid}' from {edge.upper()} bar ({slot_key}, section {sec})? [y/N]: ").strip().lower()
            if ans not in ("y", "yes"):
                print("Cancelled.")
                return

        pop_from_layout(cfg[slot_key]["layout"], target_eid)
        save_config(cfg)
        if slot_key == "bar":
            subprocess.run(["omarchy-shell", "-q", "shell", "reloadConfig"], check=False)
        call_ipc("reloadConfig")
        print(f"Removed '{target_eid}' from {edge} bar ({slot_key}).")
        return

    if sub in ("position", "pos", "edge"):
        if len(args) < 2 or args[1].lower() not in EDGES:
            sys.exit("Usage: omarchy mc-4bars position <bottom|top|left|right> [source-edge-or-slot]")
        target_edge = args[1].lower()
        cfg = load_config()
        ensure_all_bars(cfg)
        source_slot = resolve_bar_slot(cfg, args[2]) if len(args) >= 3 else "bottomBar"
        old_edge, swapped_slot = move_or_swap_edge(cfg, source_slot, target_edge)
        save_config(cfg)
        if source_slot == "bar" or swapped_slot == "bar":
            subprocess.run(["omarchy-shell", "-q", "shell", "reloadConfig"], check=False)
        call_ipc("reloadConfig")
        if swapped_slot:
            print(
                f"Moved '{source_slot}' to '{target_edge}' and swapped '{swapped_slot}' to '{old_edge}'."
            )
        else:
            print(f"Set '{source_slot}' edge position to '{target_edge}'.")
        return

    if sub in ("background", "bg"):
        if len(args) < 2 or args[1].lower() not in ("none", "glassy", "opaque", "cycle"):
            sys.exit("Usage: omarchy mc-4bars background <none|glassy|opaque|cycle> [edge-or-slot]")
        cfg = load_config()
        ensure_all_bars(cfg)
        target_slot = resolve_bar_slot(cfg, args[2]) if len(args) >= 3 else "bottomBar"
        target_bar = cfg[target_slot]
        choice = args[1].lower()
        if choice == "cycle":
            order = ["none", "glassy", "opaque"]
            cur = target_bar.get("background", "none")
            choice = order[(order.index(cur) + 1) % len(order)] if cur in order else "none"
        target_bar["background"] = choice
        save_config(cfg)
        if target_slot == "bar":
            subprocess.run(["omarchy-shell", "-q", "shell", "reloadConfig"], check=False)
        call_ipc("reloadConfig")
        print(f"Set '{target_slot}' ({target_bar.get('position')}) background to '{choice}'.")
        return

    # Shorthand: `omarchy mc-4bars <plugin-id> <L|M|R> [...]`
    if len(args) >= 2 and args[1].lower() in SECTION_ALIASES:
        cmd_move(args[0], args[1], args[2:], target_bar_or_edge="bottomBar")
        return

    sys.exit(f"Unknown subcommand '{sub}'. Run 'omarchy mc-4bars --help' for usage.")


if __name__ == "__main__":
    main()
