#!/usr/bin/env python3
"""Manage the Omarchy Quad-Edge Status Bar System (`io.github.layolayo.mc-4bars`).

Supports up to 4 independent status bars across `top`, `bottom`, `left`, and `right`
screen edges, with lazy instantiation (empty bars consume 0 surfaces), warm off-screen
parking for instant toggling, and automatic edge swapping when a bar is moved onto
an occupied screen edge.

Examples:
  omarchy mc-4bars list
  omarchy mc-4bars manager
  omarchy mc-4bars toggle [top|bottom|left|right|all]
  omarchy mc-4bars show   [top|bottom|left|right|all]
  omarchy mc-4bars hide   [top|bottom|left|right|all]
  omarchy mc-4bars swap   <top|bottom|left|right> <top|bottom|left|right>
  omarchy mc-4bars move   <plugin-id> [top|bottom|left|right] <L|M|R|T|B> [--before <id>|--after <id>|--index <n>]
  omarchy mc-4bars top    <plugin-id> [L|M|R]
  omarchy mc-4bars bottom <plugin-id> [L|M|R]
  omarchy mc-4bars left   <plugin-id> [T|M|B]
  omarchy mc-4bars right  <plugin-id> [T|M|B]
  omarchy mc-4bars <plugin-id> <L|M|R|T|B>
  omarchy mc-4bars position <bottom|top|left|right> [source-edge-or-slot]
  omarchy mc-4bars background <none|glassy|opaque|cycle> [edge-or-slot]
"""

import difflib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

PLUGIN_ID = "io.github.layolayo.mc-4bars"
LEGACY_PLUGIN_IDS = ("io.github.layolayo.mc-2bars", "matthew.bottom-bar")
SHELL_JSON = Path.home() / ".config" / "omarchy" / "shell.json"
USER_PLUGINS_DIR = Path.home() / ".config" / "omarchy" / "plugins"
SYSTEM_PLUGINS_DIR = Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")) / "shell" / "plugins"
SECTIONS = ("left", "center", "right", "tray")
EDGES = ("top", "bottom", "left", "right")
BAR_SLOTS = (
    ("bar", "top", "Primary Bar"),
    ("bottomBar", "bottom", "Secondary Bar 1"),
    ("leftBar", "left", "Secondary Bar 2"),
    ("rightBar", "right", "Secondary Bar 3"),
)
SAFE_PLUGIN_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")

SECTION_ALIASES = {
    "l": "left",
    "left": "left",
    "t": "left",
    "top": "left",
    "m": "center",
    "mid": "center",
    "middle": "center",
    "c": "center",
    "center": "center",
    "centre": "center",
    "r": "right",
    "right": "right",
    "b": "right",
    "bot": "right",
    "bottom": "right",
    "tray": "tray",
}

SLOT_ALIASES = {
    "bar": "bar",
    "primary": "bar",
    "bottombar": "bottomBar",
    "bottom-bar": "bottomBar",
    "leftbar": "leftBar",
    "left-bar": "leftBar",
    "rightbar": "rightBar",
    "right-bar": "rightBar",
}

PLUGIN_SHORT_ALIASES = {
    "omarchygotchi": "creaza.tamagotchi",
    "tamagotchi": "creaza.tamagotchi",
    "omagames": "david.omagames",
    "moon": "jeffmtb.moon-phase",
    "moon-phase": "jeffmtb.moon-phase",
    "lunar": "jeffmtb.moon-phase",
    "lunar-phase": "jeffmtb.moon-phase",
}


BUILTIN_OMARCHY_WIDGETS = {
    "omarchy.active-window": "Active Window",
    "omarchy.agents": "Agents",
    "omarchy.audio": "Audio",
    "omarchy.battery": "Battery",
